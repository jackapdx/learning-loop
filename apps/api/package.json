{
  "name": "api",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "bun run --watch --no-clear-screen src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src"
  },
  "dependencies": {
    "@trpc/server": "^11.17.0",
    "arktype": "^2.2.0",
    "hono": "^4.12.18",
    "marked": "^18.0.3",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^22.15.0",
    "typescript": "^6.0.3"
  }
}
