{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "tasks": {
    "prebuild": {
      "outputs": ["src/lib/lessons-data.ts"]
    },
    "build": {
      "dependsOn": ["^build"]
    },
    "web#build": {
      "dependsOn": ["^build", "prebuild"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {
      "dependsOn": []
    },
    "lint:fix": {
      "dependsOn": []
    },
    "format": {
      "dependsOn": []
    },
    "format:check": {
      "dependsOn": []
    },
    "preview": {
      "cache": false,
      "persistent": true
    }
  }
}
